<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="800" viewBox="0 0 1280 800" role="img" aria-labelledby="title description">
  <title id="title">Help Curupaco — tela da ferramenta</title>
  <desc id="description">Mockup em português da ferramenta Help Curupaco para registrar atendimento técnico e gerar um texto de repasse.</desc>
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7f4fc"/>
      <stop offset="1" stop-color="#eeebf5"/>
    </linearGradient>
    <linearGradient id="brand" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#6f42c1"/>
      <stop offset="1" stop-color="#8357d4"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="5" stdDeviation="12" flood-color="#32244c" flood-opacity=".10"/>
    </filter>
    <style>
      text { font-family: "Segoe UI", Arial, sans-serif; fill: #262333; }
      .muted { fill: #777486; }
      .label { font-size: 13px; font-weight: 600; }
      .small { font-size: 12px; }
      .tiny { font-size: 11px; }
      .section-title { font-size: 14px; font-weight: 700; }
      .card { fill: #fff; stroke: #ebe7f1; stroke-width: 1; }
      .field { fill: #fff; stroke: #dad6e2; stroke-width: 1; }
      .check { fill: #6f42c1; stroke: #6f42c1; stroke-width: 1; }
    </style>
  </defs>

  <rect width="1280" height="800" fill="url(#background)"/>
  <circle cx="1190" cy="82" r="160" fill="#ded1f5" opacity=".25"/>
  <circle cx="58" cy="740" r="175" fill="#e5daf8" opacity=".22"/>

  <rect x="0" y="0" width="1280" height="76" fill="url(#brand)"/>
  <rect x="48" y="17" width="42" height="42" rx="12" fill="#fff" opacity=".18"/>
  <path d="M61 39h16M69 31v16" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
  <text x="104" y="39" fill="#fff" font-size="21" font-weight="700">Help Curupaco</text>
  <text x="104" y="57" fill="#eee7fb" font-size="11">Gerador de repasse de suporte técnico</text>
  <rect x="1058" y="25" width="174" height="28" rx="14" fill="#fff" opacity=".16"/>
  <circle cx="1076" cy="39" r="4" fill="#a8f0c4"/>
  <text x="1087" y="43" fill="#fff" font-size="11" font-weight="600">ATENDIMENTO EM ANDAMENTO</text>

  <text x="48" y="113" font-size="22" font-weight="700">Registro de atendimento</text>
  <text x="48" y="136" class="muted" font-size="13">Preencha as informações e gere um repasse claro e padronizado.</text>

  <rect x="48" y="158" width="1184" height="68" rx="12" class="card" filter="url(#shadow)"/>
  <circle cx="82" cy="192" r="16" fill="#6f42c1"/>
  <text x="82" y="196" fill="#fff" text-anchor="middle" font-size="12" font-weight="700">1</text>
  <text x="109" y="189" font-size="13" font-weight="700" fill="#6f42c1">Equipamentos</text>
  <text x="109" y="207" class="muted" font-size="11">Seleção concluída</text>
  <path d="M276 192h40" stroke="#c9bddb" stroke-width="2"/>
  <circle cx="340" cy="192" r="16" fill="#6f42c1"/>
  <text x="340" y="196" fill="#fff" text-anchor="middle" font-size="12" font-weight="700">2</text>
  <text x="367" y="189" font-size="13" font-weight="700" fill="#6f42c1">Procedimentos e detalhes</text>
  <text x="367" y="207" class="muted" font-size="11">Etapa atual</text>
  <rect x="1035" y="178" width="170" height="28" rx="14" fill="#f1ebfb"/>
  <circle cx="1053" cy="192" r="4" fill="#6f42c1"/>
  <text x="1065" y="196" fill="#593196" font-size="11" font-weight="600">REPASSE ATUALIZADO</text>

  <g filter="url(#shadow)">
    <rect x="48" y="246" width="712" height="500" rx="14" class="card"/>
    <rect x="784" y="246" width="448" height="500" rx="14" class="card"/>
  </g>

  <text x="72" y="280" class="section-title">Detalhes do atendimento</text>
  <text x="72" y="300" class="muted small">Informe o problema e marque o que foi realizado.</text>

  <text x="72" y="330" class="label">Problema relatado</text>
  <rect x="72" y="340" width="664" height="40" rx="6" class="field"/>
  <text x="86" y="365" font-size="12">Catraca não está comunicando com o sistema</text>

  <text x="72" y="410" class="label">Procedimentos padrão</text>
  <rect x="72" y="420" width="14" height="14" rx="3" class="check"/>
  <path d="M75 427l3 3 5-6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="94" y="432" class="small">Ressincronização de banco</text>
  <rect x="285" y="420" width="14" height="14" rx="3" fill="#fff" stroke="#cbc6d4"/>
  <text x="307" y="432" class="small">Instalação completa</text>
  <rect x="465" y="420" width="14" height="14" rx="3" fill="#fff" stroke="#cbc6d4"/>
  <text x="487" y="432" class="small">Instalação parcial</text>

  <rect x="72" y="453" width="664" height="104" rx="8" fill="#fbf9fe" stroke="#e5d9f6"/>
  <rect x="72" y="453" width="4" height="104" rx="2" fill="#6f42c1"/>
  <text x="90" y="477" font-size="12" font-weight="700" fill="#593196">Procedimentos Catracas (Topdata)</text>
  <rect x="90" y="490" width="14" height="14" rx="3" class="check"/>
  <path d="M93 497l3 3 5-6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="112" y="502" class="small">Catraca na rede</text>
  <rect x="236" y="490" width="14" height="14" rx="3" class="check"/>
  <path d="M239 497l3 3 5-6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="258" y="502" class="small">Confirmação de Wi-Fi</text>
  <rect x="430" y="490" width="14" height="14" rx="3" class="check"/>
  <path d="M433 497l3 3 5-6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="452" y="502" class="small">Troca de IP</text>
  <text x="90" y="535" class="tiny muted">De IP</text>
  <rect x="128" y="517" width="190" height="27" rx="5" class="field"/>
  <text x="140" y="535" class="tiny">192.168.0.10</text>
  <text x="335" y="535" class="tiny muted">Para IP</text>
  <rect x="378" y="517" width="190" height="27" rx="5" class="field"/>
  <text x="390" y="535" class="tiny">192.168.0.15</text>

  <text x="72" y="588" class="label">Informações importantes</text>
  <rect x="72" y="598" width="664" height="40" rx="6" class="field"/>
  <text x="86" y="623" font-size="12">Equipamento testado e respondendo na rede local.</text>

  <text x="72" y="668" class="label">AnyDesk / Acesso remoto</text>
  <rect x="72" y="678" width="664" height="40" rx="6" class="field"/>
  <text x="86" y="703" font-size="12">123 456 789</text>

  <text x="808" y="280" class="section-title">Texto do repasse</text>
  <text x="808" y="300" class="muted small">Revise, edite se necessário e copie para compartilhar.</text>
  <rect x="808" y="318" width="400" height="337" rx="7" fill="#fcfaff" stroke="#ded8e8"/>
  <text x="826" y="344" font-family="Consolas, monospace" font-size="11.5" font-weight="700">CLEAR - REPASSE</text>
  <text x="826" y="368" font-family="Consolas, monospace" font-size="11.5" fill="#593196">@REPASSE RESUMO</text>
  <text x="826" y="402" font-family="Consolas, monospace" font-size="11">Equipamento: Catraca</text>
  <text x="826" y="428" font-family="Consolas, monospace" font-size="11">Marca/Modelo: Topdata</text>
  <text x="826" y="454" font-family="Consolas, monospace" font-size="11">Problema: Catraca não está</text>
  <text x="826" y="470" font-family="Consolas, monospace" font-size="11">comunicando com o sistema</text>
  <text x="826" y="496" font-family="Consolas, monospace" font-size="11">Procedimentos realizados:</text>
  <text x="826" y="512" font-family="Consolas, monospace" font-size="11">Ressincronização de banco,</text>
  <text x="826" y="528" font-family="Consolas, monospace" font-size="11">Catraca na rede, Confirmação</text>
  <text x="826" y="544" font-family="Consolas, monospace" font-size="11">de Wi-Fi, Troca de IP</text>
  <text x="826" y="570" font-family="Consolas, monospace" font-size="11">Informações importantes:</text>
  <text x="826" y="586" font-family="Consolas, monospace" font-size="11">Equipamento testado e respondendo</text>
  <text x="826" y="602" font-family="Consolas, monospace" font-size="11">na rede local.</text>
  <text x="826" y="628" font-family="Consolas, monospace" font-size="11">AnyDesk: 123 456 789</text>
  <rect x="808" y="671" width="400" height="44" rx="7" fill="#28a745"/>
  <rect x="949" y="685" width="13" height="12" rx="2" fill="none" stroke="#fff" stroke-width="1.5"/>
  <path d="M953 682h13v12" fill="none" stroke="#fff" stroke-width="1.5"/>
  <text x="1020" y="699" fill="#fff" text-anchor="middle" font-size="13" font-weight="700">Copiar repasse</text>

  <text x="48" y="778" class="muted" font-size="10">HELP CURUPACO  •  PADRONIZAÇÃO E AGILIDADE NO SUPORTE</text>
  <text x="1232" y="778" class="muted" text-anchor="end" font-size="10">Prévia ilustrativa da ferramenta</text>
</svg>
