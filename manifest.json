{
  "manifest_version": 3,
  "name": "Help Gojo",
  "version": "3.0",
  "description": "Consulta de clientes, faturas e indicadores Next Fit no WhatsApp Web",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "gojo-dashboard.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "clipboardWrite"],
  "optional_host_permissions": [
    "https://apiadm.nextfit.com.br/*",
    "https://api.nextfit.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "gojo-dashboard.html",
        "gojo-dashboard.css",
        "gojo-dashboard.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}